@model CSharpSoChiTieu.Business.Services.ChangePasswordViewModel


<!-- (Giữ nguyên phần <style> của bạn) -->

<div class="row justify-content-center pt-4 mt-3">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 card-change-pass">
            <!-- HEADER CARD -->
            <div class="card-header p-3 text-white" style="background: linear-gradient(195deg, #ec407a 0%, #d81b60 100%);">
                <h5 class="mb-0 text-white d-flex align-items-center fw-bold">
                    <i class="material-symbols-rounded me-2">lock</i> Đổi mật khẩu
                </h5>
            </div>

            <!-- BODY CARD -->
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Thông báo lỗi -->
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div class="alert alert-danger text-white text-xs p-2 mb-3 rounded-2" role="alert">
                            <i class="material-symbols-rounded text-sm align-middle me-1">error</i> @error.ErrorMessage
                        </div>
                    }

                    <!-- Thông báo thành công -->
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success text-white text-xs p-2 mb-3 rounded-2" role="alert">
                            <i class="material-symbols-rounded text-sm align-middle me-1">check_circle</i> @ViewBag.Success
                        </div>
                    }

                    <!-- Mật khẩu hiện tại -->
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label text-dark text-sm fw-bold">Mật khẩu hiện tại</label>
                        <div class="input-group custom-input-group">
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" value="@Model?.CurrentPassword" placeholder="Nhập mật khẩu hiện tại..." required />
                            <button type="button" class="btn btn-outline-custom" onclick="togglePassword('currentPassword', this)">
                                <i class="material-symbols-rounded text-sm">visibility</i>
                            </button>
                        </div>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="mb-3">
                        <label for="newPassword" class="form-label text-dark text-sm fw-bold">Mật khẩu mới</label>
                        <div class="input-group custom-input-group">
                            <input type="password" class="form-control" id="newPassword" name="newPassword" value="@Model?.NewPassword" placeholder="Nhập mật khẩu mới..." required />
                            <button type="button" class="btn btn-outline-custom" onclick="togglePassword('newPassword', this)">
                                <i class="material-symbols-rounded text-sm">visibility</i>
                            </button>
                        </div>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label text-dark text-sm fw-bold">Xác nhận mật khẩu mới</label>
                        <div class="input-group custom-input-group">
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" value="@Model?.ConfirmPassword" placeholder="Nhập lại mật khẩu mới..." required />
                            <button type="button" class="btn btn-outline-custom" onclick="togglePassword('confirmPassword', this)">
                                <i class="material-symbols-rounded text-sm">visibility</i>
                            </button>
                        </div>
                    </div>

                    <!-- Nút Đổi mật khẩu -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-gradient-custom py-2 text-sm shadow-sm" style="background: linear-gradient(195deg, #ec407a 0%, #d81b60 100%); color: white;">
                            Đổi mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .card-change-pass {
        border-radius: 1rem;
        overflow: hidden;
    }

    /* Bo tròn và tạo viền bao quanh cả nhóm input */
    .custom-input-group {
        display: flex !important;
        align-items: stretch !important;
        border: 1px solid #d2d6da !important;
        border-radius: 0.5rem !important;
        overflow: hidden !important;
        transition: border-color 0.2s ease-in-out;
    }

        /* Hiệu ứng viền hồng khi focus vào ô input */
        .custom-input-group:focus-within {
            border-color: #e91e63 !important;
        }

        /* Xóa viền riêng biệt của thẻ input */
        .custom-input-group .form-control {
            border: none !important;
            border-radius: 0 !important;
            height: 42px !important;
            padding: 0.5rem 0.75rem !important;
            box-shadow: none !important;
        }

        /* Xóa viền riêng biệt của nút icon con mắt */
        .custom-input-group .btn-outline-custom {
            border: none !important;
            border-radius: 0 !important;
            background-color: #fff;
            color: #6c757d;
            height: 42px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 0 12px !important;
            margin: 0 !important;
        }

            .custom-input-group .btn-outline-custom:hover {
                background-color: #f8f9fa;
                color: #e91e63;
            }

    .btn-gradient-custom {
        background-color: #e91e63;
        background-image: linear-gradient(195deg, #ec407a 0%, #d81b60 100%);
        color: #fff;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }

        .btn-gradient-custom:hover {
            opacity: 0.9;
            color: #fff;
        }
</style>

<script>
    function togglePassword(id, button) {
        const input = document.getElementById(id);
        const icon = button.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.innerText = "visibility_off";
        } else {
            input.type = "password";
            icon.innerText = "visibility";
        }
    }
</script>